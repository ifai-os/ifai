# 复制为 .env 后填写（.env 不进仓库）。生产和预览环境的值填在 Vercel → Settings → Environment Variables。
# 每一项去哪里拿，见 docs/setup.md。

# ── 站点 ───────────────────────────────────────────────
# 生产域名，只在 Production 环境设置；预览环境会自动用 Vercel 分配的地址
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# 1 = 第一期（日报、应用、资源）；2 加上推荐、圈子；3 全部模块
NEXT_PUBLIC_SITE_PHASE=1

# ── 数据库：Neon Postgres ──────────────────────────────
# 本地填 Neon 的 dev 分支。用了 Neon 的 Vercel 集成时，预览环境会自动注入 DATABASE_URL，可以不填这一项
DATABASE_URI=postgres://USER:PASSWORD@HOST/DBNAME?sslmode=require

# ── Payload 后台 ───────────────────────────────────────
# 任意 32 位以上随机字符串：openssl rand -base64 32
PAYLOAD_SECRET=

# ── 账号：Better Auth ──────────────────────────────────
# 任意 32 位以上随机字符串，和 PAYLOAD_SECRET 不要相同
BETTER_AUTH_SECRET=
# 可选。不填时：生产用 NEXT_PUBLIC_SITE_URL，预览用 Vercel 地址
BETTER_AUTH_URL=

# Google 登录（不填就不显示 Google 按钮）
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub 登录（不填就不显示 GitHub 按钮）
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# 邮箱魔法链接：Resend。本地开发不填时，登录链接会打印在终端里
RESEND_API_KEY=
EMAIL_FROM="IFAI <hello@example.com>"
# 日报邮件的发件地址（生产填 news@ifai.io），回信直接回到这个邮箱；发件人名称按语言自动加。
# 部署的环境要和 RESEND_API_KEY 一起配好，订阅框才出现；本地不填时，欢迎信和每天的邮件打印在终端里
DAILY_EMAIL_FROM=
# Resend 回调（退信、投诉、送达）的签名密钥，whsec_ 开头，在 Resend 的 Webhooks 里添加端点后复制。
# 只填在生产环境；不填时回调接口返回 503，退信和投诉不会自动停发
RESEND_WEBHOOK_SECRET=

# ── 文件：Cloudflare R2（S3 兼容）──────────────────────
# 四项都填才启用 R2；不填时上传的文件存在本地 media/ 目录
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# 可选：存储桶的公开访问地址（r2.dev 或自定义域名），用于直接输出图片链接
R2_PUBLIC_URL=

# ── 总开关 ─────────────────────────────────────────────
# 只有写成 true 才会运行；不填或写别的都算关。生产环境确认预算后再打开
# COLLECT_ENABLED 管日报采集；MODEL_CALLS_ENABLED 管所有模型调用（日报判断写作、应用资料草稿、评价翻译）；
# DAILY_EMAIL_ENABLED 管日报邮件（订阅框、新订阅、每天早上的发送），本地要看订阅框时设 true
COLLECT_ENABLED=false
MODEL_CALLS_ENABLED=false
DAILY_EMAIL_ENABLED=false

# ── 模型：OpenRouter（统一经过 src/lib/ai）──────────────
# 填好后用 pnpm ai:smoke 试一次真实调用（三次小调用，费用不到 0.01 美元）
OPENROUTER_API_KEY=
# 可选，只在本机测试用：把调用指向任何兼容 OpenAI 接口的服务（填到 /v1 为止），
# 模型名用下面的 AI_MODEL_<用途> 指定。这类服务不报费用，预算统计会是 0；向量用途仍需要向量模型
# OPENROUTER_BASE_URL=http://192.168.1.100:3425/v1
# 每天（上海时间）的模型费用上限，单位美元；用完就暂停，第二天自动恢复。不填时为 10
AI_DAILY_BUDGET_USD=10
# 可选：日报评分门槛（0–100），按信源分级；不填用规格里的 T1 60、T1_5 65、T2 76
# DAILY_SCORE_THRESHOLD_T1=
# DAILY_SCORE_THRESHOLD_T1_5=
# DAILY_SCORE_THRESHOLD_T2=
# 可选：给某个用途单独换模型，填 OpenRouter 的模型 ID。用途见 src/lib/ai/purposes.ts
# AI_MODEL_PREFILTER=
# AI_MODEL_SCORE=
# AI_MODEL_STRUCTURE=
# AI_MODEL_GROUP=
# AI_MODEL_WRITE=
# AI_MODEL_ASSIST=
# AI_MODEL_PROFILE=      # 应用资料草稿
# AI_MODEL_DESCRIBE=     # Skill 说明草稿
# AI_MODEL_TRANSLATE=    # 应用评价翻译
# AI_MODEL_EMBED=        # 换成向量维度不是 1536 的模型需要先改迁移

# ── 应用：页面设置 ─────────────────────────────────────
# 写成 true 才在页面显示 Tranco 名次（列表「网站排名」列、详情页）；不填不显示，名次照常算进热度。
# 看过 Tranco 的使用条款再打开（docs/specs/apps.md 第 8 条）
APPS_SHOW_TRANCO_RANK=false
# 可选，上海日期（YYYY-MM-DD）：这天之前收录的应用不进「新上架」榜和「本周新上架」。
# 首批应用导入完后填上线那天，免得首批应用占满新上架一个月
# APPS_NEW_SINCE=2026-11-01

# ── 资源：Skill 导入 ───────────────────────────────────
# 可选。导入任务从 GitHub 拉公开仓库的快照，不填也能用；填一个只读的个人令牌（Fine-grained，
# 只给 Contents: Read）可以提高接口限额、导入私有仓库。和登录用的 GITHUB_CLIENT_* 无关
GITHUB_TOKEN=

# ── 后台任务：Inngest ──────────────────────────────────
# 本地开发：先运行 pnpm inngest（Inngest 本地服务），并设 INNGEST_DEV=1
INNGEST_DEV=1
# 生产 / 预览：装了 Vercel 的 Inngest 集成会自动注入这两项，本地不用填
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
