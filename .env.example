# 复制为 .env 后填写（.env 不进仓库）。生产和预览环境的值填在 Vercel → Settings → Environment Variables。
# 每一项去哪里拿，见 docs/setup.md。

# ── 站点 ───────────────────────────────────────────────
# 生产域名，只在 Production 环境设置；预览环境会自动用 Vercel 分配的地址
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# 1 = 第一期（日报、应用、资源）；2 加上推荐、圈子；3 全部模块
NEXT_PUBLIC_SITE_PHASE=1

# ── 数据库：Neon Postgres ──────────────────────────────
# 本地填 Neon 的 dev 分支。用了 Neon 的 Vercel 集成时，预览环境会自动注入 DATABASE_URL，可以不填这一项
DATABASE_URI=postgres://USER:PASSWORD@HOST/DBNAME?sslmode=require

# ── Payload 后台 ───────────────────────────────────────
# 任意 32 位以上随机字符串：openssl rand -base64 32
PAYLOAD_SECRET=

# ── 账号：Better Auth ──────────────────────────────────
# 任意 32 位以上随机字符串，和 PAYLOAD_SECRET 不要相同
BETTER_AUTH_SECRET=
# 可选。不填时：生产用 NEXT_PUBLIC_SITE_URL，预览用 Vercel 地址
BETTER_AUTH_URL=

# Google 登录（不填就不显示 Google 按钮）
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub 登录（不填就不显示 GitHub 按钮）
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# 邮箱魔法链接：Resend。本地开发不填时，登录链接会打印在终端里
RESEND_API_KEY=
EMAIL_FROM="IFAI <hello@example.com>"

# ── 文件：Cloudflare R2（S3 兼容）──────────────────────
# 四项都填才启用 R2；不填时上传的文件存在本地 media/ 目录
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# 可选：存储桶的公开访问地址（r2.dev 或自定义域名），用于直接输出图片链接
R2_PUBLIC_URL=

# ── 日报：总开关 ───────────────────────────────────────
# 只有写成 true 才会运行；不填或写别的都算关。生产环境确认预算后再打开
COLLECT_ENABLED=false
MODEL_CALLS_ENABLED=false

# ── 模型：OpenRouter（统一经过 src/lib/ai）──────────────
# 填好后用 pnpm ai:smoke 试一次真实调用（三次小调用，费用不到 0.01 美元）
OPENROUTER_API_KEY=
# 每天（上海时间）的模型费用上限，单位美元；用完就暂停，第二天自动恢复。不填时为 10
AI_DAILY_BUDGET_USD=10
# 可选：给某个用途单独换模型，填 OpenRouter 的模型 ID。用途见 src/lib/ai/purposes.ts
# AI_MODEL_PREFILTER=
# AI_MODEL_SCORE=
# AI_MODEL_STRUCTURE=
# AI_MODEL_GROUP=
# AI_MODEL_WRITE=
# AI_MODEL_ASSIST=
# AI_MODEL_EMBED=        # 换成向量维度不是 1536 的模型需要先改迁移

# ── 后台任务：Inngest ──────────────────────────────────
# 本地开发：先运行 pnpm inngest（Inngest 本地服务），并设 INNGEST_DEV=1
INNGEST_DEV=1
# 生产 / 预览：装了 Vercel 的 Inngest 集成会自动注入这两项，本地不用填
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
